---
import Layout from '../../layouts/Layout.astro';
import { formatPostDate, getPublishedPosts } from '../../lib/collections';

const posts = await getPublishedPosts();
---

<Layout title="Blog" description="Updates from the CrateWorks team.">
  <section class="px-6 py-16 sm:py-24 max-w-3xl mx-auto">
    <header class="mb-12">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Blog</h1>
      <p class="text-muted mt-4 leading-relaxed">
        Updates from the CrateWorks team — announcements, design notes, release news. Also available as an
        <a href="/rss.xml" class="text-accent hover:underline">RSS feed</a>.
      </p>
    </header>

    <ul class="space-y-8 list-none p-0">
      {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="block group no-underline">
              <time datetime={post.data.pubDate.toISOString()} class="text-sm text-muted">
                {formatPostDate(post.data.pubDate)}
              </time>
              <h2 class="text-2xl font-semibold tracking-tight mt-1 group-hover:text-accent">
                {post.data.title}
              </h2>
              <p class="text-muted mt-2 leading-relaxed">{post.data.description}</p>
            </a>
          </li>
        ))}
    </ul>
  </section>
</Layout>
