---
const layers = [
  {
    title: "It's RO-Crates all the way down",
    body: 'The data format. A JSON-LD metadata file that describes a research dataset and everything inside it. Everything in CrateWorks is built around RO-Crates',
  },

  {
    title: 'Component: Storage layer',
    body: 'A project starts by choosing a storage layer - a place to put your RO-Crates; a simple set of directories (as used by RasboCrate) or "H51v2" an archival-quality, version controlled Oxford Common Filesystem Layout (OCFL), or roll your own',
  },

  {
    title: 'AROCAPI: An RO-Crate API',
    body: 'The storage layer speaks AROCAPI, a specification for how any repository serves its collections of RO-Crates over HTTP. Includes discovery, retrieval, deposit and sustainable access control.',
  },
  {
    title: 'Data Portals',
    body: 'From simple static websites to full-scale data marts, data can be made available on the web via AROCAPI or directly for a single RO-Crate. Oni is one top-level portal option.',
  },
  {
    title: 'Tools',
    body: 'Data preparation, adding metadata, transcribing, annotating through to analysing data - tools just need to understand RO-Crate and they can be slotted-in anywhere in the data-journey, using the API or directly on an RO-Crate',
  },
];

const mermaidDiagram = `%%{init: {'theme':'base','themeVariables': {'background':'#ffffff','primaryColor':'#ffffff','primaryBorderColor':'#f97316','lineColor':'#f97316','tertiaryColor':'#ffffff','clusterBkg':'#ffffff','clusterBorder':'#f97316','defaultLinkColor':'#f97316'}}}%%
flowchart TB
  subgraph DP["Data Portals"]
    direction TB
    ONI["OnI: full-service data portal"]
    SV["Static Viewer"]
  end

  subgraph ST["Storage Layer"]
    direction TB
    API(["ARPOCAPI"])
    H51["H51v2"]
    RAS["Raspbo Crate"]
    API --> H51
    API --> RAS
  end

  DP --> ST

  linkStyle 0,1 stroke:transparent,fill:transparent,stroke-width:2px;
  linkStyle 2 stroke:#f97316,stroke-width:2.5px;

  classDef main fill:#ffffff,stroke:#f97316,stroke-width:2px,color:#111827;
  classDef option fill:#ffffff,stroke:#f97316,stroke-width:1.5px,color:#111827;
  classDef tool fill:#ffffff,stroke:#f97316,stroke-width:1.5px,color:#111827,stroke-dasharray: 4 3;

  class DP,API,ST main;
  class ONI,SV,H51,RAS option;
`;
---

<section id="architecture" class="px-6 py-10 sm:py-14 bg-white">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-bold tracking-tight mb-3">The foundation</h2>
    <p class="text-muted max-w-2xl mb-12">Two specifications, two main architectural components tied together with an API and many tools</p>

    <div class="grid sm:grid-cols-2 gap-8 items-start">
      <ol class="space-y-5 list-none p-0 m-0">
        {layers.map((layer, i) => (
            <li class="flex gap-4">
              <span class="shrink-0 w-8 h-8 rounded-full bg-accent text-white flex items-center justify-center font-semibold">{i + 1}</span>
              <div>
                <h3 class="font-semibold text-lg">{layer.title}</h3>
                <p class="text-muted text-sm leading-relaxed">{layer.body}</p>
              </div>
            </li>
          ))}
      </ol>

      <div class="w-full max-w-3xl mx-auto" aria-label="Layered architecture diagram">
        <pre class="mermaid overflow-x-auto">{mermaidDiagram}</pre>
      </div>
    </div>
  </div>
</section>

<script>
import mermaid from 'mermaid';

mermaid.initialize({
  startOnLoad: false,
  securityLevel: 'loose',
});

const renderMermaid = async () => {
  await mermaid.run({ querySelector: '.mermaid' });
};

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', renderMermaid, { once: true });
} else {
  renderMermaid();
}
</script>
