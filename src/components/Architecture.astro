---
const layers = [
  {
    title: 'RO-Crate',
    body: 'The data format. A JSON-LD metadata file that describes a research dataset and everything inside it.',
  },
  {
    title: 'RO-Crate API',
    body: 'The access protocol. A specification for how any repository serves its RO-Crates over HTTP — discovery, retrieval, deposit, access control.',
  },
  {
    title: 'Arocapi',
    body: 'The reference implementation. A library you mount into a Fastify or Express app, with pluggable storage and external authority for access control.',
  },
  {
    title: 'The tools',
    body: 'Discovery portals, downloaders, viewers, capture appliances, annotators — all written against the API, not against any particular repository.',
  },
];
---

<section id="architecture" class="px-6 py-10 sm:py-14 bg-accent-soft/40">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-bold tracking-tight mb-3">The foundation</h2>
    <p class="text-muted max-w-2xl mb-12">
      Two specifications, one reference implementation, many consumers. Anything in the bottom row can be swapped out — they all speak the same API.
    </p>

    <div class="grid sm:grid-cols-2 gap-8 items-start">
      <ol class="space-y-5 list-none p-0 m-0">
        {layers.map((layer, i) => (
            <li class="flex gap-4">
              <span class="shrink-0 w-8 h-8 rounded-full bg-accent text-white flex items-center justify-center font-semibold">{i + 1}</span>
              <div>
                <h3 class="font-semibold text-lg">{layer.title}</h3>
                <p class="text-muted text-sm leading-relaxed">{layer.body}</p>
              </div>
            </li>
          ))}
      </ol>

      <svg viewBox="0 0 320 320" class="w-full max-w-md mx-auto text-fg" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <title>Architecture stack</title>

        <rect x="60" y="30" width="200" height="44" rx="6" />
        <text x="160" y="58" text-anchor="middle" font-size="14" fill="currentColor" stroke="none" font-weight="600">RO-Crate (data format)</text>

        <rect x="60" y="98" width="200" height="44" rx="6" />
        <text x="160" y="126" text-anchor="middle" font-size="14" fill="currentColor" stroke="none" font-weight="600">An RO-Crate API (protocol)</text>

        <rect x="60" y="166" width="200" height="44" rx="6" stroke="var(--color-accent)" stroke-width="2" />
        <text x="160" y="194" text-anchor="middle" font-size="14" fill="var(--color-accent)" stroke="none" font-weight="700">Arocapi (reference impl)</text>

        <path d="M160 74 L160 96" />
        <path d="M160 142 L160 164" />

        <path d="M160 210 L160 234 L40 234 L40 256" />
        <path d="M160 234 L100 234 L100 256" />
        <path d="M160 234 L160 256" />
        <path d="M160 234 L220 234 L220 256" />
        <path d="M160 234 L280 234 L280 256" />

        <g font-size="10" fill="currentColor" stroke="none" text-anchor="middle">
          <rect x="14" y="256" width="52" height="40" rx="4" fill="none" stroke="currentColor" />
          <text x="40" y="280">Oni</text>

          <rect x="74" y="256" width="52" height="40" rx="4" fill="none" stroke="currentColor" />
          <text x="100" y="275">Down-</text>
          <text x="100" y="287">loader</text>

          <rect x="134" y="256" width="52" height="40" rx="4" fill="none" stroke="currentColor" />
          <text x="160" y="275">Static</text>
          <text x="160" y="287">Viewer</text>

          <rect x="194" y="256" width="52" height="40" rx="4" fill="none" stroke="currentColor" />
          <text x="220" y="275">Raspbo-</text>
          <text x="220" y="287">Crate</text>

          <rect x="254" y="256" width="52" height="40" rx="4" fill="none" stroke="currentColor" />
          <text x="280" y="280">Cockatiel</text>
        </g>
      </svg>
    </div>
  </div>
</section>
