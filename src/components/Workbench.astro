---
import { getCollection } from 'astro:content';
import { byOrder } from '../lib/collections';
import ToolTile from './ToolTile.astro';

const tools = (await getCollection('tools')).sort(byOrder);
---

<section id="workbench" class="px-6 py-16 sm:py-24 max-w-6xl mx-auto">
  <div class="mb-12">
    <h2 class="text-3xl font-bold tracking-tight">The workbench</h2>
    <p class="text-muted mt-3 max-w-2xl">Each tool is independent, open-source, and built to compose with the others through an RO-Crate API.</p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {tools.map((tool) => (
        <ToolTile
          name={tool.data.name}
          tagline={tool.data.tagline}
          summary={tool.data.summary}
          repo={tool.data.repo}
          site={tool.data.site}
          status={tool.data.status}
        />
      ))}
  </div>
</section>
