  <path d="M16 32 L40 45" opacity="0.55" />
  <path d="M16 42 L40 55" opacity="0.55" />
  <path d="M64 32 L40 45" opacity="0.55" />
  <path d="M64 42 L40 55" opacity="0.55" />

  <path d="M44 28 L60 4" />
  <path d="M56 4 L66 2 L62 12 L52 14 Z" />
