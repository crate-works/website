---
interface Props {
  homeHref: string;
  homeLabel: string;
}

const { homeHref, homeLabel } = Astro.props;
---

<article class="px-6 py-12 sm:py-16 max-w-3xl mx-auto">
  <nav class="text-sm text-muted mb-6">
    <a href={homeHref} class="hover:text-accent">{homeLabel}</a>
    <span class="mx-2">/</span>
    <slot name="trailing" />
  </nav>

  <slot name="header" />

  <div class="prose prose-lg max-w-none">
    <slot />
  </div>
</article>
